<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ConsoleTables</id>
    <version>2.7.0</version>
    <authors>khalidabuhakmeh</authors>
    <license type="expression">MIT</license>
