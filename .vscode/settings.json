{
  "biome.enabled": false,
  "dotnet.defaultSolution": "GLJ2026.slnx",
  "editor.defaultFormatter": "ms-dotnettools.csdevkit",
  "editor.detectIndentation": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "search.exclude": {
    "**/*.csproj": true,
    "**/*.slnx": true,
    "**/.gitignore": true,
    ".vscode/": true,
    "**/Packages/": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}/GLJ2026",
  "terminal.integrated.scrollback": 10000,
  "todo-tree.highlights.enabled": false,
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.)).*($TAGS)",
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "better-comments.tags": [
    {
      "background": "transparent",
      "bold": true,
      "color": "#a6192e",
      "tag": "!"
    },
    {
      "background": "transparent",
      "bold": true,
      "color": "#0057b8",
      "tag": "?"
    },
    {
      "background": "transparent",
      "color": "#474747",
      "tag": "//"
    },
    {
      "background": "transparent",
      "bold": true,
      "color": "#ff9900",
      "tag": "todo"
    },
    {
      "background": "transparent",
      "bold": true,
      "color": "#04b34f",
      "tag": "*"
    }
  ],
  "cSpell.import": [
    "${workspaceFolder}/.vscode/cspell.json"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.formatDocument": "explicit"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "support.type.property-name.table",
        "settings": {
          "foreground": "#4ec9b0"
        }
      },
      {
        "scope": "support.type.property-name.array",
        "settings": {
          "foreground": "#569cd6"
        }
      },
      {
        "scope": "constant.other.time",
        "settings": {
          "foreground": "#dcdcaa"
        }
      },
      {
        "scope": "string.quoted",
        "settings": {
          "foreground": "#ce9178"
        }
      }
    ]
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "GLJ2026.slnx": "*.csproj"
  },
  "files.exclude": {
    "GLJ2026/Library": true,
    "GLJ2026/Logs": true,
    "GLJ2026/obj": true,
    "GLJ2026/Temp": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/.vscode/settings.json",
    "**/TODO.md"
  ],
  "todo-tree.general.tags": [
    "TODO"
  ]
}
